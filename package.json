{
  "name": "api-loadtest",
  "version": "1.0.0",
  "private": true,
  "description": "API load/concurrency tester: React UI + Node.js benchmark server",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter api-loadtest-server dev",
    "dev:client": "pnpm --filter api-loadtest-client dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck --if-present",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  }
}
